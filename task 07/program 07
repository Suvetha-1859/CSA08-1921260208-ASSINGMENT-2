"""Q7 - Redesigned program: loop keeping only the last two values.

Run AFTER original.py. Appends its rows to results.csv and compares answers.
"""

import csv
import time

steps = 0


def ways_loop(n):
    """Same answer as ways_naive(n), using O(n) time and O(1) extra space."""
    global steps
    a, b = 1, 1                      # ways(0), ways(1)
    for _ in range(n - 1):
        steps += 1
        a, b = b, a + b
    return b


# Same inputs as the original, plus n = 1000 (impossible for plain recursion)
SIZES = (10, 20, 25, 30, 1000)

# Read the original's answers so both versions can be compared
original_answers = {}
try:
    with open("results.csv", newline="") as f:
        for row in csv.DictReader(f):
            if row["version"] == "original":
                original_answers[int(row["n"])] = int(row["answer"])
except FileNotFoundError:
    print("results.csv not found - run original.py first")

# Correctness check against the hand answers for n = 1 to 6
hand = {1: 1, 2: 2, 3: 3, 4: 5, 5: 8, 6: 13}
print("Hand check n=1..6:", all(ways_loop(n) == v for n, v in hand.items()))

with open("results.csv", "a", newline="") as f:      # "a": add to the file
    writer = csv.writer(f)
    print(f"\n{'n':>4} {'steps':>6} {'time (s)':>10} {'same as original?':>18}")
    for n in SIZES:
        steps = 0
        start = time.perf_counter()
        answer = ways_loop(n)
        elapsed = time.perf_counter() - start
        if n in original_answers:
            same = "yes" if answer == original_answers[n] else "NO"
        else:
            same = "n/a (original cannot run)"
        print(f"{n:>4} {steps:>6} {elapsed:>10.6f} {same:>18}")
        writer.writerow([n, "redesign", answer, steps, f"{elapsed:.6f}"])

