# ---------------------------------------------------------------
# Positional, keyword and default parameters
# ---------------------------------------------------------------
PRICES = {"Tea": 10, "Vada": 15, "Coffee": 20, "Samosa": 12}


def add_item_priced(order, item, qty=1):
    """order and item are required (positional); qty has a default."""
    order.append((item, qty))
    return order


order = []
add_item_priced(order, "Tea")                 # positional, default qty
add_item_priced(order, "Vada", qty=2)         # keyword argument
add_item_priced(order, item="Coffee", qty=3)  # all keyword
print("\nPriced order:", order)


# ---------------------------------------------------------------
# Returning more than one value (total and GST)
# ---------------------------------------------------------------
def bill(order, gst_rate=0.05):
    total = sum(PRICES[item] * qty for item, qty in order)
    gst = round(total * gst_rate, 2)
    return total, gst, round(total + gst, 2)   # returns a tuple


total, gst, grand = bill(order)
print(f"Total = Rs{total}, GST = Rs{gst}, Payable = Rs{grand}")


# ---------------------------------------------------------------
# Local, global and nonlocal names
# ---------------------------------------------------------------
orders_served = 0            # global


def serve_wrong():
    orders_served = orders_served + 1   # UnboundLocalError: treated as local
    return orders_served


def serve_right():
    global orders_served                # needed to CHANGE a global name
    orders_served += 1
    return orders_served


print("\nGlobal without 'global' keyword:")
try:
    serve_wrong()
except UnboundLocalError as e:
    print("  UnboundLocalError:", e)

serve_right()
serve_right()
print("  orders_served after two serve_right() calls =", orders_served)


def outer():
    count = 0                           # local to outer, enclosing for inner

    def inner():
        nonlocal count                  # changes outer's variable
        count += 1
        return count

    inner()
    inner()
    return count


print("nonlocal example, outer() returns", outer())


def local_demo():
    x = "local"                         # exists only inside this function
    return x


x = "global"
print("local_demo() =", local_demo(), "| global x still =", x)

# Why globals are usually avoided: any function can change them, so bugs are
# hard to trace and functions cannot be tested alone. Pass values in as
# parameters and return results instead.


