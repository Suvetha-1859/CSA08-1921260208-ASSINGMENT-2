# ---------------------------------------------------------------
# Alternative 1: caller always passes the list explicitly
# ---------------------------------------------------------------
def add_item_explicit(item, order):
    order.append(item)
    return order


print("\nExplicit list:", add_item_explicit("Tea", []), add_item_explicit("Vada", []))


# ---------------------------------------------------------------
# Alternative 2: closure (inner function keeps the order)
# ---------------------------------------------------------------
def new_order():
    order = []

    def add(item):
        order.append(item)
        return order

    return add


add_a = new_order()
add_b = new_order()
add_a("Tea")
add_a("Vada")
add_b("Coffee")
print("Closure customer A:", add_a("Samosa"))
print("Closure customer B:", add_b("Tea"))
