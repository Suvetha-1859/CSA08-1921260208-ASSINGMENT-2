import time

# Three methods to build the same text

def build_plus(parts):
    text = ""
    for p in parts:
        text += p + ";"
    return text


def build_join(parts):
    # Build the text using a list and join()
    text_parts = [p + ";" for p in parts]
    return "".join(text_parts)


def build_fstring(parts):
    # Build each line using an f-string
    return "".join(f"{p};" for p in parts)


# Test with different numbers of items
sizes = [1000, 10000, 200000]

for size in sizes:

    items = [f"Item{i}:Rs{i % 50}" for i in range(size)]

    print("\nNumber of items:", size)

    methods = [
        ("Repeated +=", build_plus),
        ("List + join()", build_join),
        ("F-string", build_fstring)
    ]

    for name, function in methods:

        total_time = 0

        # Run three times and calculate average
        for run in range(3):
            start = time.perf_counter()
            result = function(items)
            end = time.perf_counter()

            total_time += end - start

        average = total_time / 3

        print(name, "Average time:", round(average, 4), "seconds")

        if name == "List + join()":
            print("Output length:", len(result))

    # Check whether all methods produce the same text
    a = build_plus(items)
    b = build_join(items)
    c = build_fstring(items)

    print("All outputs same:", a == b == c)
